rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Función para saber si es el Súper Administrador
    function isSuperAdmin() {
      // Permitimos acceso total al email especificado
      return request.auth != null && request.auth.token.email == "joseprado049321@gmail.com";
    }

    // 2. Reglas para la colección de usuarios (Perfiles)
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer los perfiles (Necesario para el Leaderboard)
      allow read: if request.auth != null || isSuperAdmin();
      
      // Un usuario solo puede crear o actualizar su propia cuenta
      allow create, update: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // Solo el Súper Administrador puede borrar cuentas directamente desde la base de datos
      allow delete: if isSuperAdmin();
    }

    // 3. Reglas para la colección de preguntas (Historial)
    match /questions/{questionId} {
      // El usuario solo puede leer sus propias respuestas
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      
      // El usuario solo puede crear respuestas a su nombre
      allow create: if isSuperAdmin() || (request.auth != null && request.auth.uid == request.resource.data.userId);
      
      // No se pueden editar ni borrar las respuestas históricas (A menos que seas Súper Admin)
      allow update, delete: if isSuperAdmin();
    }

    // 4. Bloquear cualquier otra colección por defecto (Blindaje total)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
