rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Función para saber si es el Súper Administrador
    function isSuperAdmin() {
      // Permitimos acceso total al email especificado
      return request.auth != null && request.auth.token.email == "joseprado049321@gmail.com";
    }

    // 2. Reglas para la colección de usuarios (Perfiles)
    match /users/{userId} {
      // Solo el dueño de la cuenta puede leer su perfil (Privacidad de datos y Leaderboard seguro)
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // Solo el dueño puede crear su cuenta
      allow create: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // Solo el dueño puede actualizar su cuenta, PERO no puede modificar isPro.
      allow update: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPro'])));
      
      // Solo el Súper Administrador puede borrar cuentas directamente desde la base de datos
      allow delete: if isSuperAdmin();

      // 3. Subcolección de caché de IA (preguntasGeneradas)
      match /preguntasGeneradas/{docId} {
         allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // 4. Reglas para la colección de preguntas
    match /questions/{questionId} {
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if isSuperAdmin() || (request.auth != null && request.auth.uid == request.resource.data.userId);
      allow update, delete: if isSuperAdmin();
    }

    // 5. Bloquear cualquier otra colección por defecto (Blindaje total)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
